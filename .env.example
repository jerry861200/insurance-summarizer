# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# LLM provider: set LLM_PROVIDER=anthropic to use Anthropic; openai to use OpenAI
LLM_PROVIDER=anthropic

# Model selection
# Dev (max quality):       claude-opus-4-7
# Production (balanced):   claude-sonnet-4-6
# Cost-optimized (scale):  claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-opus-4-7

# OpenAI API (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Storage
DATABASE_URL=sqlite:///./insurance.db
STORAGE_DIR=./storage/pdfs

# Limits
MAX_PDF_MB=20

# App
ENVIRONMENT=dev
